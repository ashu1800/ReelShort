# ---------------------------------------------------------------------------
# Release signing (mirrors the policy of android-app/.gitignore).
#
# The Flutter client is signed with the same official ShortLink certificate as
# the Kotlin client, so every signing input and generated keystore stays out of
# version control. Release builds fail closed when these are absent; see
# docs/signing.md.
# ---------------------------------------------------------------------------
android/key.properties
android/local.properties
*.jks
*.keystore
*.p12
*.signing.properties
release-signing/signing-config.txt
