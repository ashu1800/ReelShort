<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ replaces the window background with the system splash
         screen. Without this override the platform uses the launcher icon,
         whose adaptive background layer is the dark app canvas, so a black
         square appeared on the light splash background. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <!-- Same edge-to-edge contract as values/styles.xml; the v31 file
             redeclares the style, so the items have to be repeated here. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
