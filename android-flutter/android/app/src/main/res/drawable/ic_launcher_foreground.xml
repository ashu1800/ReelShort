<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon foreground: the ShortLink "episode spine" mark - a portrait reel frame
     with a vertical rail whose centre tick is the accent violet. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Portrait reel frame -->
    <path
        android:pathData="M44,22h20a6,6 0 0 1 6,6v52a6,6 0 0 1 -6,6h-20a6,6 0 0 1 -6,-6v-52a6,6 0 0 1 6,-6z"
        android:strokeColor="#8CF4F5F7"
        android:strokeWidth="3" />
    <!-- Spine rail -->
    <path
        android:pathData="M46,32v44"
        android:strokeColor="#A69AA1AE"
        android:strokeLineCap="round"
        android:strokeWidth="2" />
    <!-- Watched tick -->
    <path
        android:pathData="M43,40h7"
        android:strokeColor="#B39AA1AE"
        android:strokeLineCap="round"
        android:strokeWidth="2.5" />
    <!-- Current tick: the accent -->
    <path
        android:pathData="M43,54h9"
        android:strokeColor="#FF9C8BFF"
        android:strokeLineCap="round"
        android:strokeWidth="3.5" />
    <!-- Remaining tick -->
    <path
        android:pathData="M43,68h7"
        android:strokeColor="#B39AA1AE"
        android:strokeLineCap="round"
        android:strokeWidth="2.5" />
    <!-- Play glyph, tying the mark to video -->
    <path
        android:fillColor="#FFF4F5F7"
        android:pathData="M58,50.5l7,3.5l-7,3.5z" />
</vector>
