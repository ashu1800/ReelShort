<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon foreground: the ShortLink play badge.

     A single solid rounded square carrying one play triangle. The mark is
     deliberately reduced: at 32 dp every extra element (device frames, episode
     rails, counters) collapses into noise, while one badge and one glyph stay
     crisp down to the smallest launcher size.

     Geometry is confined to the 66 dp safe zone (21..87 on both axes) that every
     Android adaptive-icon mask keeps, so no mask can crop the badge. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Badge: 68 dp square, 21 dp corner radius, inset 20 dp all round. -->
    <path
        android:pathData="M41,20h26a21,21 0 0 1 21,21v26a21,21 0 0 1 -21,21h-26a21,21 0 0 1 -21,-21v-26a21,21 0 0 1 21,-21z"
        android:fillColor="#FF6C4DFF" />
    <!-- Play glyph: optically centred (shifted 3 dp right of the badge centre),
         so the triangle does not read as leaning left. -->
    <path
        android:fillColor="#FFF7F8FA"
        android:pathData="M46,37.5l27,16.5l-27,16.5z" />
</vector>
