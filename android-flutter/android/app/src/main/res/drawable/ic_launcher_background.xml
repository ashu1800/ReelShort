<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon background: the dark app canvas with a soft violet
     halo radial-centred behind the badge, so the badge sits in a pool of its own
     colour instead of floating on flat black.

     The halo is a set of concentric translucent circles rather than a gradient:
     VectorDrawable has no radial-gradient primitive, and stacking a handful of
     low-alpha discs produces the same falloff with no runtime cost. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- App canvas (#0B0D11, AppColors.dark.canvas). -->
    <path
        android:fillColor="#FF0B0D11"
        android:pathData="M0,0h108v108h-108z" />
    <!-- Halo: five discs, 0.05 alpha each, so the centre accumulates to ~0.25. -->
    <path
        android:fillColor="#0D6C4DFF"
        android:pathData="M54,16a38,38 0 1,1 0,76a38,38 0 1,1 0,-76z" />
    <path
        android:fillColor="#0D6C4DFF"
        android:pathData="M54,22a32,32 0 1,1 0,64a32,32 0 1,1 0,-64z" />
    <path
        android:fillColor="#0D6C4DFF"
        android:pathData="M54,28a26,26 0 1,1 0,52a26,26 0 1,1 0,-52z" />
    <path
        android:fillColor="#0D6C4DFF"
        android:pathData="M54,34a20,20 0 1,1 0,40a20,20 0 1,1 0,-40z" />
    <path
        android:fillColor="#0D6C4DFF"
        android:pathData="M54,40a14,14 0 1,1 0,28a14,14 0 1,1 0,-28z" />
</vector>
