# Copy this file to infra/.env before running docker compose:
#   powershell -Command "Copy-Item .env.example .env"
#   docker compose --env-file .env up -d --build
# Replace every production secret placeholder before deployment.
#
# 标注说明：
#   必填 = Compose 未设置（或留空）时拒绝解析部署配置
#   可选 = 已给出默认值，留空即使用默认值
# 只列出 docker-compose.yml 实际透传的键；未被透传的后端变量不会被注入容器，
# 清单见 infra/README.md「Compose 透传边界」。

# ---------------------------------------------------------------------------
# 数据层
# ---------------------------------------------------------------------------
POSTGRES_DB=reelshort
POSTGRES_USER=reelshort
# 必填。Compose 未设置时拒绝启动；每次部署前替换占位值。
POSTGRES_PASSWORD=change-me-postgres-password
# 可选。仅 docker-compose.local-debug.yml 使用，端口只绑定 127.0.0.1。
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# 入口与限流
# ---------------------------------------------------------------------------
# 可选。Nginx 发布到宿主机的端口，默认 80。
NGINX_PORT=80
# 可选。仅 docker-compose.local-debug.yml 使用，端口只绑定 127.0.0.1。
REDIS_PORT=6379
# 可选。Compose 部署默认使用 Redis 存储限流计数，内存模式用 memory。
REELSHORT_RATE_LIMIT_STORE=redis
# 必填。后端采纳 X-Forwarded-For 的可信代理白名单，逗号分隔，支持精确 IP 与 CIDR。
# 容器内 remoteAddr 是 Docker 网关地址，不配置则后端忽略 XFF，全部匿名客户端
# 塌缩为同一个限流键（单人即可打满全平台登录配额）。
# 查看实际子网（项目名默认取 infra 目录，网络通常是 infra_default）：
#   docker inspect reelshort-nginx --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{$v.IPAddress}}{{"\n"}}{{end}}'
#   docker network inspect infra_default --format '{{(index .IPAM.Config 0).Subnet}}'
# 下面的值只是示例，部署前必须替换为真实子网。
REELSHORT_TRUSTED_PROXIES=172.18.0.0/16

# ---------------------------------------------------------------------------
# 业务开关与内部密钥
# ---------------------------------------------------------------------------
# 可选。自动打款执行能力开关，默认 false（只读/人工确认路径不受影响）。
REELSHORT_WITHDRAWAL_PAYOUT_ENABLED=false
# 可选。后端与 content-provider 之间的内部共享密钥，两侧必须同值；留空表示不启用。
CONTENT_PROVIDER_INTERNAL_TOKEN=
# 可选。保护 /api/internal/** 的超级 Token；缺失时后端内部运营接口不可用。
REELSHORT_INTERNAL_SUPER_TOKEN=change-me-internal-super-token
# 必填。支付回调共享密钥，Compose 未设置时拒绝启动，生产强度不足后端会拒绝启动。
REELSHORT_PAYMENT_CALLBACK_SECRET=change-me-payment-callback-secret
# 必填（生产）。管理员 BCrypt 哈希，无生产回退值；缺失或使用公开口令后端拒绝启动。
REELSHORT_ADMIN_USERNAME=admin
REELSHORT_ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# 内容源（content-provider）
# ---------------------------------------------------------------------------
REELSHORT_SITE_URL=https://www.reelshort.com
REELSHORT_SITE_ID=37
# 可选。单次上游调用总超时（秒），默认 10。
REELSHORT_REQUEST_TIMEOUT_SECONDS=10
# 可选。单次上游响应体最大字节数，默认 5 MiB。
REELSHORT_MAX_RESPONSE_BYTES=5242880
# 可选。单次上游请求允许的最大重定向次数，默认 3。
REELSHORT_MAX_REDIRECTS=3
# 可选。为空时自动发现 Next.js build id。
REELSHORT_NEXT_BUILD_ID=
# 可选。片库扩容关键词（逗号分隔），留空关闭扩容。
REELSHORT_CATALOG_SEARCH_KEYWORDS=
REELSHORT_CATALOG_SEARCH_KEYWORDS_EN=
REELSHORT_CATALOG_MAX_PAGES_PER_KEYWORD=3
REELSHORT_CATALOG_MAX_BOOKS=500
REELSHORT_CATALOG_REQUEST_WORKERS=8

# ---------------------------------------------------------------------------
# 内容缓存刷新（backend）
# ---------------------------------------------------------------------------
REELSHORT_CONTENT_REFRESH_ENABLED=true
REELSHORT_CONTENT_REFRESH_INITIAL_DELAY=5m
REELSHORT_CONTENT_REFRESH_INTERVAL=6h
REELSHORT_CONTENT_REFRESH_SHELVES=recommend
# 可选。内容源当前只支持 en；写多个值时同一货架会被重复刷新。
REELSHORT_CONTENT_REFRESH_LOCALES=en
REELSHORT_CONTENT_VIDEO_FALLBACK_TTL=10m

# ---------------------------------------------------------------------------
# 数据库与迁移
# ---------------------------------------------------------------------------
# 可选。生产保持 validate，schema 只由 Flyway 迁移管理。
REELSHORT_JPA_DDL_AUTO=validate
REELSHORT_FLYWAY_ENABLED=true

# ---------------------------------------------------------------------------
# Android 发布（腾讯云 COS 预签名下载）
# ---------------------------------------------------------------------------
# 可选。留空时 /api/app/release/latest 无法返回可用下载链接。
REELSHORT_COS_SECRET_ID=
REELSHORT_COS_SECRET_KEY=
REELSHORT_COS_REGION=ap-chengdu
REELSHORT_COS_BUCKET=
# 可选。APK 预签名下载链接有效期，默认 1h。
REELSHORT_RELEASE_PRESIGN_TTL=1h

# ---------------------------------------------------------------------------
# 提现 / 链上收款（TRON · ETH · BSC）
# ---------------------------------------------------------------------------
# 可选。热钱包公开地址白名单；配置后签名前会 fail-closed 校验派生地址。
REELSHORT_TRON_HOT_WALLET_ADDRESS=
REELSHORT_ETH_HOT_WALLET_ADDRESS=
REELSHORT_BSC_HOT_WALLET_ADDRESS=
# 可选。TronGrid API Key，留空时按公共节点限速节流。
REELSHORT_TRON_API_KEY=
REELSHORT_TRON_INCOMING_TRANSFER_MAX_PAGES=50
REELSHORT_TRON_REQUEST_INTERVAL=250ms
REELSHORT_TRON_RATE_LIMIT_RETRIES=3
REELSHORT_TRON_RETRY_INITIAL_DELAY=1s
REELSHORT_TRON_CHAIN_PARAMETER_CACHE_TTL=5m
# 可选。链上节点与合约地址：换 RPC 节点或切换测试网时必须在这里覆盖（默认值见 application.properties）。
REELSHORT_TRON_NODE_URL=https://api.trongrid.io
REELSHORT_TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
REELSHORT_TRON_REQUIRED_CONFIRMATIONS=20
REELSHORT_ETH_NODE_URL=https://mainnet.infura.io/v3/
REELSHORT_ETH_API_KEY=
REELSHORT_ETH_USDT_CONTRACT=0xdAC17F958D2ee523a2206206994597C13D831ec7
REELSHORT_ETH_CHAIN_ID=1
REELSHORT_ETH_REQUIRED_CONFIRMATIONS=12
REELSHORT_BSC_NODE_URL=https://bsc-dataseed.binance.org/
REELSHORT_BSC_API_KEY=
REELSHORT_BSC_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955
REELSHORT_BSC_CHAIN_ID=56
REELSHORT_BSC_REQUIRED_CONFIRMATIONS=15
REELSHORT_BSC_USDT_DECIMALS=18
# 可选。VIP 订单链上确认宽限期：付款时间仍须落在原订单窗口内，宽限只延后最终过期。
REELSHORT_VIP_CONFIRMATION_GRACE=10m

# ---------------------------------------------------------------------------
# 安全限流与凭证锁定
# ---------------------------------------------------------------------------
# 凭证爆破锁定：连续失败达到阈值后锁定一段时间，钱包改绑与改密共用同一计数。
REELSHORT_CREDENTIAL_GUARD_MAX_FAILURES=5
REELSHORT_CREDENTIAL_GUARD_LOCK_DURATION=15m
# 关键限流阈值（窗口格式如 1m/30s）。完整规则表见 backend 的 application.properties。
REELSHORT_RATE_LIMIT_APP_CAPTCHA_LIMIT=10
REELSHORT_RATE_LIMIT_APP_CAPTCHA_WINDOW=1m
REELSHORT_RATE_LIMIT_APP_WALLET_LIMIT=10
REELSHORT_RATE_LIMIT_APP_WALLET_WINDOW=1m
REELSHORT_RATE_LIMIT_APP_WALLET_BIND_LIMIT=10
REELSHORT_RATE_LIMIT_APP_WALLET_BIND_WINDOW=1m
REELSHORT_RATE_LIMIT_APP_WITHDRAWAL_LIMIT=5
REELSHORT_RATE_LIMIT_APP_WITHDRAWAL_WINDOW=1m
REELSHORT_RATE_LIMIT_APP_SOCIAL_LIMIT=30
REELSHORT_RATE_LIMIT_APP_SOCIAL_WINDOW=1m

# ---------------------------------------------------------------------------
# 资源上限与日志
# ---------------------------------------------------------------------------
# 可选。Hikari 连接池上限，默认 30。
REELSHORT_DB_POOL_MAXIMUM_SIZE=30
# 可选。后端日志文件与后台日志查看范围（容器内为非 root 用户可写的 /app/logs）。
REELSHORT_LOG_FILE=logs/backend.log
REELSHORT_SYSTEM_LOG_ROOT=logs
REELSHORT_SYSTEM_LOG_MAX_LINES=500
REELSHORT_SYSTEM_LOG_MAX_BYTES=1048576
