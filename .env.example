# ReelShort publish-android.py configuration.
# Copy this file to ".env" at the repo root and fill in real values.
# ".env" is gitignored; NEVER commit secrets.

# Tencent COS credentials and bucket for APK hosting.
COS_SECRET_ID=AKID...
COS_SECRET_KEY=...
COS_BUCKET=your-bucket-1234567890
COS_REGION=ap-chengdu

# Backend base URL (no trailing slash) where /api/internal/release/publish is exposed.
RELEASE_BACKEND_URL=https://your-backend.example.com

# Internal super token protecting the publish endpoint (same value deployed to the backend
# via REELSHORT_INTERNAL_SUPER_TOKEN). Must be at least 32 chars with high entropy.
REELSHORT_INTERNAL_SUPER_TOKEN=...

# Optional expected payout hot-wallet public addresses. When configured, payout signing
# fails closed if the selected network's value does not match the submitted private key.
# When empty, the address derived from the submitted private key is used for the payout intent.
# Address formats: TRON uses T..., while Ethereum and BSC use 0x...
REELSHORT_TRON_HOT_WALLET_ADDRESS=
REELSHORT_TRON_API_KEY=
REELSHORT_TRON_REQUEST_INTERVAL=250ms
REELSHORT_TRON_RATE_LIMIT_RETRIES=3
REELSHORT_TRON_RETRY_INITIAL_DELAY=1s
REELSHORT_TRON_CHAIN_PARAMETER_CACHE_TTL=5m
REELSHORT_ETH_HOT_WALLET_ADDRESS=
REELSHORT_BSC_HOT_WALLET_ADDRESS=

# VIP receipt reconciliation. A payment is on time when its block timestamp is at most
# `expiresAt + grace`; the order itself expires at the same moment, so a payment that
# lands while the countdown shows 0:00 is still auto-confirmed.
REELSHORT_VIP_CONFIRMATION_GRACE=10m
# Expired orders stay in the auto-confirm scan for this long, so an on-time payment is
# still recovered automatically when the scan was interrupted (node/provider outage).
REELSHORT_VIP_EXPIRED_RECOVERY_WINDOW=24h
REELSHORT_TRON_INCOMING_TRANSFER_MAX_PAGES=50

# ---------------------------------------------------------------------------
# Compose 栈使用的键（与 infra/.env.example 保持一致）。
# 发布脚本不读取以下三个键，列在这里是为了让单份根 .env 也能直接复制到 infra/.env；
# 键名对照：根 .env 的 COS_SECRET_ID/COS_SECRET_KEY/COS_REGION/COS_BUCKET 对应
# Compose 的 REELSHORT_COS_SECRET_ID/REELSHORT_COS_SECRET_KEY/REELSHORT_COS_REGION/
# REELSHORT_COS_BUCKET，RELEASE_BACKEND_URL 仅发布脚本使用。
# ---------------------------------------------------------------------------
# Compose 必填：后端采纳 X-Forwarded-For 的可信代理白名单，支持精确 IP 与 CIDR。
# 生产 Docker 场景填 Nginx 所在的 Docker 子网（示例值，部署前必须替换为真实子网）。
REELSHORT_TRUSTED_PROXIES=172.18.0.0/16
# 可选，默认 false：自动打款执行能力开关。
REELSHORT_WITHDRAWAL_PAYOUT_ENABLED=false
# 可选，默认 72h：超过该时长未审核的提现申请自动拒绝并释放冻结积分。
REELSHORT_WITHDRAWAL_PENDING_TIMEOUT=72h
# 可选：后端与 content-provider 之间的内部共享密钥，两侧必须配置为同一取值。
CONTENT_PROVIDER_INTERNAL_TOKEN=
# 可选：TwistyTV（默认内容上游）的抓取参数。上游切换本身是后台系统配置
# content.upstream=TWISTYTV|REELSHORT，不在这里配。
# TWISTYTV_SITE_URL=https://twistytv.com
# TWISTYTV_REQUEST_TIMEOUT_SECONDS=15
# TWISTYTV_MAX_RESPONSE_BYTES=4194304
# TWISTYTV_PAGE_CACHE_SECONDS=600
# TWISTYTV_MAX_SHELF_PAGES=12
# TWISTYTV_MAX_GENRE_PAGES=3
# TWISTYTV_EPISODE_COUNT_CACHE_SECONDS=604800
# TWISTYTV_EPISODE_COUNT_BACKFILL=100
# TWISTYTV_DURATION_PROBE_ENABLED=true
# TWISTYTV_REQUEST_INTERVAL_SECONDS=0.3
