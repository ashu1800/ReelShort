# /etc/cardservice/cardservice.env  （chmod 600，属主 root）
#
# 首次启动会用它创建初始管理员（只在数据库里没有任何管理员时生效）；
# 创建完成后建议删除下面两行，需要重置口令时用：
#   /srv/cardservice/current/cardservice -reset-admin-password admin

CARDSERVICE_ADDR=127.0.0.1:8090
CARDSERVICE_DB_PATH=/var/lib/cardservice/cardservice.db

# CARDSERVICE_BOOTSTRAP_ADMIN_USERNAME=admin
# CARDSERVICE_BOOTSTRAP_ADMIN_PASSWORD=<至少 10 位的随机口令>
CARDSERVICE_BOOTSTRAP_ADMIN_DISPLAY=超级管理员

# 生产环境必须为 true（Cookie 只在 HTTPS 下发送）
CARDSERVICE_COOKIE_SECURE=true

# 只有来自这些地址的 X-Forwarded-For / CF-Connecting-IP 才会被采信（本机 nginx）
CARDSERVICE_TRUSTED_PROXIES=127.0.0.1/32,::1/128

CARDSERVICE_LOG_LEVEL=info
CARDSERVICE_ACCESS_LOG=true
CARDSERVICE_RATE_LIMIT_GLOBAL_PER_MINUTE=600
